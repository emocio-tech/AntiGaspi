# Copier ce fichier en .env et renseigner les vraies valeurs (le .env n'est jamais versionné).

# LLM : proxy compatible OpenAI fourni par la formation
LLM_BASE_URL=https://proxy.exemple.invalid
LLM_API_KEY=cle-factice-a-remplacer
LLM_MODEL=nova-lite

# Base PostgreSQL (valeurs par défaut : docker compose up -d db). Décommenter pour changer.
# DB_URL=jdbc:postgresql://localhost:5432/antigaspi
DB_USER=antigaspi
DB_PASSWORD=antigaspi

# Profil utilisateur (préférences alimentaires), gitignoré
PROFILE_PATH=../data/profil.md
