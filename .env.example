# Gabarit des variables d'environnement : copier en .env et remplir.
# .env contient les secrets (clé API LLM) : il n'est jamais commité,
# et Claude Code n'y a pas accès en lecture (voir .claude/settings.json).

# --- LLM (fournisseur interchangeable sans toucher au code métier) ---
# bedrock | anthropic | openai
LLM_PROVIDER=bedrock
LLM_MODEL=amazon.nova-lite-v1:0
LLM_API_KEY=
# Bedrock uniquement
AWS_REGION=

# --- Base de données (PostgreSQL via docker-compose) ---
POSTGRES_DB=antigaspi
POSTGRES_USER=antigaspi
POSTGRES_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/antigaspi

# --- Profil utilisateur (préférences, équipement, historique des retours) ---
PROFILE_PATH=./data/profil.md
