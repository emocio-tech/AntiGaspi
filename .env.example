# Gabarit des variables d'environnement : copier en .env et remplir.
# .env contient les secrets (clé API LLM) : il n'est jamais commité,
# et Claude Code n'y a pas accès en lecture (voir .claude/settings.json).

# --- LLM (fournisseur interchangeable sans toucher au code métier) ---
# openai : proxy compatible OpenAI de la formation, qui sert Nova Lite (par défaut)
# bedrock : Amazon Bedrock en direct (identifiants AWS ci-dessous)
LLM_PROVIDER=openai
# Proxy compatible OpenAI : URL (sans /v1), clé et nom du modèle exposé
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=nova-lite

# Bedrock en direct uniquement (LLM_PROVIDER=bedrock)
# Modèle : en région EU, inference profile préfixé "eu." (us-east-1 : amazon.nova-lite-v1:0)
BEDROCK_MODEL=eu.amazon.nova-lite-v1:0
AWS_REGION=eu-west-3
# Authentification, au choix :
#  1. clé API Bedrock (console Bedrock > API keys, commence par "ABSK") :
AWS_BEARER_TOKEN_BEDROCK=
#  2. clés d'accès IAM (laisser vides pour utiliser ~/.aws : aws configure / aws sso login) :
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Base de données (PostgreSQL via docker-compose) ---
POSTGRES_DB=antigaspi
POSTGRES_USER=antigaspi
POSTGRES_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/antigaspi

# --- Profil utilisateur (préférences, équipement, historique des retours) ---
# Relatif au dossier de lancement du backend (backend/ avec Maven)
PROFILE_PATH=../data/profil.md
