{
  "model": "sonnet",
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\Users\\fferre\\.claude\\hooks\\auto-commit-push.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\Users\\fferre\\.claude\\hooks\\pre-commit-check.ps1",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\Users\\fferre\\.claude\\hooks\\pre-push-tests.ps1",
            "timeout": 900
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\Users\\fferre\\.claude\\hooks\\stop-tests.ps1",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -File C:\\Users\\fferre\\.claude\\statusline.ps1"
  }
}
